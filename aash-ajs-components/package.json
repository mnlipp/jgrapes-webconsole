{
  "name": "aash-alpinejs",
  "version": "0.0.1",
  "author": "Michael N. Lipp",
  "license": "AGPL-3.0-only",
  "description": "Components for generating 'ARIA augmented Semantic HTML' (AaSH)",
  "type": "module",
  "exports": {
    "types": "./lib/AashComponents.d.ts",
    "import": "./lib/aash-alpinejs-components.js",
    "require": "./lib/aash-alpinejs-components.cjs.js"
  },
  "main": "lib/aash-alpinejs-components.cjs.js",
  "module": "lib/aash-alpinejs-components.js",
  "scripts": {
    "build": "rollup -c",
    "build:doc": "typedoc",
    "demo": "browser-sync start --config bs-config.cjs"
  },
  "files": [
    "/src",
    "/lib"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mnlipp/jgrapes-webconsole"
  },
  "dependencies": {
    "alpinejs":"^3.17.4"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/alpinejs": "^3.13.11",
    "browser-sync": "^3.0.3",
    "postcss": "^8.5.25",
    "rollup": "^4.31.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.37.0",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.17",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "lit",
    "rollup",
    "typescript",
    "component",
    "library",
    "semantic",
    "accessibility"
  ]
}
